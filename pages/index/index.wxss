.container {
  padding: 20rpx;
  background-color: #f5f5f5;
}
.add-btn{
  background:#07c160;
  color:#fff;
  text-align:center;
  line-height:80rpx;
  border-radius:12rpx;
  margin-bottom:20rpx;
  font-size:32rpx;
}
.book-item {
  display: flex;
  margin-bottom: 20rpx;
  background: #fff;
  padding:20rpx;
  border-radius:12rpx;
}
.cover {
  width:160rpx;
  height:220rpx;
  margin-right:20rpx;
}
.title {
  font-size:32rpx;
  display:block;
}
.author {
  font-size:26rpx;
  color:#666;
  margin-top:10rpx;
}

/*弹窗样式*/
.mask{
  position:fixed;
  top:0;
  left:0;
  right:0;
  bottom:0;
  background:rgba(0,0,0,0.5);
  display:flex;
  align-items:center;
  justify-content:center;
  z-index:999;
}
.popup{
  width:85%;
  background:#fff;
  border-radius:16rpx;
  padding:30rpx;
  max-height:80vh;
  overflow-y:auto;
}
.popup-title{
  text-align:center;
  font-size:34rpx;
  font-weight:bold;
  margin-bottom:20rpx;
}
.tip{
  color:#07c160;
  font-size:24rpx;
  margin:8rpx 0 16rpx;
}
.del-tip{
  text-align:center;
  font-size:28rpx;
  margin-bottom:30rpx;
}
.btn-row{
  display:flex;
  gap:20rpx;
  margin-top:20rpx;
}
.cancel-btn{
  flex:1;
  background:#eee;
  color:#333;
}
button{
  margin:0;
}
